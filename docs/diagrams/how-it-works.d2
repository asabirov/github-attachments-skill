direction: right
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "github-attachments: a path goes in, a URL comes out" {
  near: top-center
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
}

image: "local\nimage" {class: outside}
checks: "mint.sh\nchecks the file" {class: core}
refused: "refused\nnothing uploaded" {class: records}
direct: "curl upload\nwith gh token" {class: core}
broker: "gh-mint\nbroker upload" {class: core}
github: "GitHub\nattachments" {class: outside}
url: "attachment\nURL" {class: records}

image -> checks: "path"
checks -> refused: "bad file"
checks -> direct: "gh login"
checks -> broker: "no gh login"
direct -> github
broker -> github
github -> url
